# Copy to backend/.env and fill in. Leave the values empty to show example data for Naver.
# Google Trends needs no key. Never commit backend/.env.

# Naver DataLab search trend API. Keys from NAVER API HUB (Naver Cloud console,
# https://api.ncloud-docs.com/docs/naver-api-hub-search-trend) or an older developers.naver.com app.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
