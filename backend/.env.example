# Copy to backend/.env and fill in only the channels you use. Leave a value empty to show example data.
# Never commit backend/.env.

# Naver DataLab (https://developers.naver.com/apps)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Meta Ad Library (token with ads_read). App ID and secret are optional: with them the token is renewed before it expires.
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Pinterest Trends (also add pinterest to ENABLED_PLATFORMS)
PINTEREST_ACCESS_TOKEN=
ENABLED_PLATFORMS=naver,google,meta
